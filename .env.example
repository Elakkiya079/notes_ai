# Leave blank for local development. Set to production to turn off the local preview account.
ENV=

MONGODB_URI=mongodb://127.0.0.1:27017/notes_ai
JWT_SECRET=replace-with-a-long-random-string
ENCRYPTION_KEY=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173
PORT=5050

# Google Cloud OAuth client. Authorized redirect URI must match GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5050/api/auth/google/callback

# GitHub OAuth app, used only when the user connects GitHub for private repositories.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5050/api/auth/github/callback

# Optional. Raises the rate limit for public repository reads. Never exposed to the browser.
GITHUB_TOKEN=

# Free Gemini key from Google AI Studio. Model is overridable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite


